datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum ProductType {
  DIGITAL
  LEAD_MAGNET
  PHYSICAL
  EXTERNAL_LINK
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
}

enum ShippingStatus {
  UNFULFILLED
  SHIPPING
  COMPLETED
}

enum PaymentProvider {
  PAYOS
  SEPAY
  MANUAL_VIETQR
}

enum UserRole {
  CREATOR
  ADMIN
  SUPPORT
}

model User {
  id                String          @id @default(cuid())
  clerkUserId       String?         @unique
  email             String          @unique
  password          String?
  role              UserRole        @default(CREATOR)
  isActive          Boolean         @default(true)
  name              String?
  displayName       String?         @default("Tiệm Nhỏ Creator")
  username          String?         @unique @default("tiemnho")
  avatarUrl         String?         @default("/default-avatar.svg")
  coverUrl          String?         @default("https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?w=1200&auto=format&fit=crop&q=80")
  bio               String?         @default("Chào mừng bạn ghé Tiệm Nhỏ! Nơi chia sẻ các tài nguyên số chất lượng cao.")
  phone             String?
  verified          Boolean         @default(true)
  theme             String          @default("obsidian")
  tiktok            String?         @default("https://tiktok.com/@tiemnho")
  instagram         String?         @default("https://instagram.com/tiemnho")
  youtube           String?         @default("https://youtube.com/@tiemnho")
  threads           String?         @default("https://threads.net/@tiemnho")
  facebook          String?         @default("https://facebook.com/tiemnho")
  zalo              String?         @default("0987654321")
  bankAccountNumber String?         @default("0988667788")
  bankBin           String?         @default("970422")
  telegramChatId    String?
  telegramLinkToken String?         @unique

  paymentConfig     PaymentConfig?
  products          Product[]
  orders            Order[]
  leads             Lead[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model Product {
  id            String      @id @default(cuid())
  userId        String?
  user          User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  creatorId     String      @default("creator-1")
  type          ProductType @default(DIGITAL)
  title         String
  subtitle      String?
  description   String?     @db.Text
  price         Int         @default(0)
  originalPrice Int?
  coverImage    String?     @default("https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?w=800&auto=format&fit=crop&q=80")
  fileUrl       String?
  fileName      String?
  externalUrl   String?
  buttonText    String?     @default("Tải ngay")
  isPublished   Boolean     @default(true)
  isFeatured    Boolean     @default(false)
  displayOrder  Int         @default(0)
  soldCount     Int         @default(0)
  stock         Int?        @default(999)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  orders        Order[]
}

model Order {
  id              String          @id @default(cuid())
  orderCode       String          @unique
  userId          String?
  user            User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  creatorId       String          @default("creator-1")
  productId       String?
  product         Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  productTitle    String
  productType     ProductType     @default(DIGITAL)
  amount          Float
  customerName    String
  customerEmail   String
  customerPhone   String
  shippingAddress String?
  customerNote    String?
  status          OrderStatus     @default(PENDING)
  shippingStatus  ShippingStatus? @default(UNFULFILLED)
  paymentMethod   String          @default("PAYOS")
  paidAt          DateTime?
  downloadUrl     String?
  checkoutUrl     String?
  qrCode          String?         @db.Text
  paymentLinkId   String?
  accountNumber   String?
  accountName     String?
  bin             String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model Lead {
  id            String   @id @default(cuid())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  creatorId     String   @default("creator-1")
  name          String
  email         String
  phone         String
  sourceProduct String
  sourceType    String   @default("LEAD_MAGNET")
  totalSpent    Float    @default(0)
  ordersCount   Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model PaymentConfig {
  id                String          @id @default(uuid())
  userId            String          @unique
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  provider          PaymentProvider @default(PAYOS)
  isActive          Boolean         @default(false)
  isPayosEnabled    Boolean         @default(false)

  // Thông tin ngân hàng nhận tiền trực tiếp
  bankBin           String          @default("970422") // Mã BIN (VD: 970422 - MBBank, 970436 - Vietcombank)
  bankAccountNumber String          @default("0988667788") // Số tài khoản
  bankAccountName   String          @default("DINH VAN GIANG") // Tên chủ tài khoản viết hoa không dấu
  bankId            String?         @default("MB") // Mã ngắn nhận diện ngân hàng
  bankName          String?         @default("Ngân hàng TMCP Quân Đội (MB Bank)")

  // Bộ 3 khóa API của payOS (Cần lưu trữ an toàn)
  clientId          String?
  apiKey            String?
  checksumKey       String?
  webhookUrl        String?         // Endpoint nhận webhook của Creator hoặc endpoint chung
  lastPingTestAt    DateTime?

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model OtpVerification {
  id        String   @id @default(cuid())
  email     String
  code      String
  payload   String?  @db.Text
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

